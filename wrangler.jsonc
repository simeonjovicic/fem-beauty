{
  "name": "fem-gutscheine",
  "main": "worker/src/index.js",
  "compatibility_date": "2026-08-06",
  // stripe-node erwartet Node-Bausteine (Buffer, crypto, events).
  "compatibility_flags": ["nodejs_compat"],

  // Nur diese Pfade. Alles andere auf fembeauty.at bedient weiterhin der
  // bestehende Worker fem-beauty — bei Cloudflare gewinnt die
  // spezifischere Route, die laufende Seite bleibt also unberuehrt.
  //
  // www eigens aufgefuehrt: die Adresse antwortet eigenstaendig mit 200
  // und leitet nicht auf die Hauptdomain um. Ohne diese Routen schluege
  // ein Kauf dort fehl.
  "routes": [
    { "pattern": "fembeauty.at/api/*", "zone_name": "fembeauty.at" },
    { "pattern": "fembeauty.at/v/*", "zone_name": "fembeauty.at" },
    { "pattern": "www.fembeauty.at/api/*", "zone_name": "fembeauty.at" },
    { "pattern": "www.fembeauty.at/v/*", "zone_name": "fembeauty.at" }
  ],

  "d1_databases": [
    {
      // Der Bindungsname ist frei gewählt und heißt im Code env.DB.
      // Wrangler schlägt beim Anlegen den Datenbanknamen vor; das ist nur
      // ein Vorschlag und hätte hier eine Umbenennung überall erzwungen.
      "binding": "DB",
      "database_name": "fem-gutscheine",
      // Echte Datenbank in der Region EEUR.
      //
      // Achtung beim Ändern: der lokale Zustand unter .wrangler/state ist
      // nach dieser ID abgelegt. Eine neue ID heißt deshalb auch lokal
      // leere Tabellen — nach einem Wechsel muss das Schema mit
      // `wrangler d1 execute fem-gutscheine --local --file worker/schema.sql`
      // erneut angewendet werden.
      "database_id": "106c17f4-25f9-4420-837c-6bdc5386e02f"
    }
  ],

  // Schriften und Logo landen als Binärdaten im Bündel: das PDF wird zur
  // Laufzeit erzeugt, es kann also nichts nachladen. Eng begrenzt auf die
  // beiden Ordner, damit nicht versehentlich andere Dateien mitwandern.
  // fallthrough, damit Wranglers Standardregeln erhalten bleiben.
  "rules": [
    { "type": "Data", "globs": ["**/*.ttf", "**/*.png"], "fallthrough": true },
    { "type": "Text", "globs": ["**/*.html"], "fallthrough": true }
  ],

  "vars": {
    // Ursprünge, die /api/checkout aus dem Browser aufrufen dürfen.
    // Im Betrieb laufen Seite und Worker gleichursprünglich, dann leer.
    // Produktionswerte. Lokal ueberschreibt .dev.vars beide — ein
    // deployter Worker mit localhost-Adressen waere kaputt, und der
    // Fehler faellt erst auf, wenn eine Kundin schon bezahlt hat.
    //
    // ALLOWED_ORIGINS leer: im Betrieb liegen Seite und API auf
    // demselben Ursprung, CORS wird dort nicht gebraucht.
    "ALLOWED_ORIGINS": "",
    "PUBLIC_SITE_URL": "https://fembeauty.at",

    // Zugang zum Panel.
    //
    // "dev"    — jeder mit der Adresse kommt herein. NUR lokal.
    // "access" — Cloudflare Access davor, das Token wird geprueft.
    //
    // Bewusst eine eigene Variable statt "kein Header = offen": eine
    // fehlende Einstellung soll sperren, nicht oeffnen.
    //
    // VOR DEM DEPLOY auf "access" stellen und die beiden Werte darunter
    // ausfuellen. Ohne sie sperrt der Worker jeden Zugriff — richtig so,
    // aber dann ist das Panel auch fuer euch zu.
    // Voreinstellung ist der sichere Zustand. Wer versehentlich deployt,
    // deployt ein geschlossenes Panel — nicht ein offenes.
    //
    // Lokal steht ADMIN_AUTH_MODE=dev in .dev.vars und ueberschreibt das;
    // .dev.vars ist gitignoriert und wird nie deployed.
    "ADMIN_AUTH_MODE": "access",

    // ACCESS_AUD und ACCESS_TEAM_DOMAIN stehen bewusst NICHT hier: das
    // Repo ist oeffentlich. Beide sind zwar keine Geheimnisse — die
    // Kennung steht in jedem Access-Token, die Team-Domain in jeder
    // Weiterleitung zur Anmeldung —, aber sie beschreiben die
    // Zugangsschicht, und die muss nicht im Klartext nachlesbar sein.
    //
    // Lokal in .dev.vars, in der Cloud per:
    //   wrangler secret put ACCESS_AUD
    //   wrangler secret put ACCESS_TEAM_DOMAIN

    // Absender der Gutscheinmails. Die Domain muss bei Resend verifiziert
    // sein, sonst weist die API die Sendung ab.
    //
    // Eigene Adresse statt beauty@: Antworten auf eine automatische Mail
    // sollen trotzdem im gelesenen Postfach landen — dafuer MAIL_REPLY_TO.
    "MAIL_FROM": "FEM Beauty Wien <gutschein@fembeauty.at>",
    "MAIL_REPLY_TO": "beauty@fembeauty.at",
    "BOOKING_URL": "https://trea.tw/uc3hWqqxxVC9uu2Yj"
  }

  // Secrets stehen NICHT hier, sondern lokal in .dev.vars und
  // in der Cloud via `wrangler secret put`:
  //   STRIPE_API_KEY
  //   STRIPE_WEBHOOK_SECRET
}
